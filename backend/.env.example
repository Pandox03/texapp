APP_NAME="TexFlow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=texflow
DB_USERNAME=texflow
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend URL (CORS + Sanctum)
FRONTEND_URL=http://localhost:5173

# Initial admin (required in production — php artisan db:seed)
ADMIN_NAME="Administrateur"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Company defaults (seeded into company_settings — editable in app Settings)
COMPANY_TAGLINE="Import textile & gestion de stock"
COMPANY_LEGAL_NAME="${APP_NAME}"
COMPANY_LEGAL_FORM=SARL
# COMPANY_ICE=
# COMPANY_RC=
# COMPANY_RC_CITY=
# COMPANY_ADDRESS=
# COMPANY_CITY=
COMPANY_COUNTRY=Maroc
# COMPANY_ACTIVITY=
# COMPANY_CAPITAL=
# COMPANY_PHONE=
# COMPANY_EMAIL=
# COMPANY_IF=
# COMPANY_TP=
# COMPANY_CNSS=
COMPANY_CURRENCY=MAD
COMPANY_TAX_RATE=20
COMPANY_PAYMENT_TERMS=30
# COMPANY_LOGO_PATH=public/images/logo.png

VITE_APP_NAME="${APP_NAME}"

# OpenRouter AI (assistant, client summaries, pricing hints)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TIMEOUT=90
OPENROUTER_CONNECT_TIMEOUT=30
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL="${APP_URL}"
# OPENROUTER_SITE_NAME="${APP_NAME}"
